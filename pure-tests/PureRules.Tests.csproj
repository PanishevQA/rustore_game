    <Compile Include="../UnityProject/Assets/Game/Social/*.cs" Link="Social/%(Filename)%(Extension)" />
    <Compile Include="../UnityProject/Assets/Game/Economy/*.cs" Link="Economy/%(Filename)%(Extension)" />
